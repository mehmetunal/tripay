@model ResetPasswordViewModel
<span data-admin-module="users.resetPassword" class="hidden" aria-hidden="true"></span>
<h1 class="sr-only">Şifre sıfırla</h1>

<a asp-action="Index" data-admin-ajax-link class="mb-4 inline-block text-sm text-tripay-700 hover:underline">← Kullanıcılar</a>

<div class="mx-auto max-w-md rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <p class="mb-4 text-sm text-slate-600">Kullanıcı: <strong>@Model.Email</strong></p>
    <form asp-action="ResetPassword" method="post" data-admin-ajax="json" class="space-y-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Email" />
        <div data-admin-validation-summary class="hidden text-sm text-red-600"></div>
        <div>
            <label asp-for="Password" class="mb-1 block text-sm font-medium text-slate-700"></label>
            <input asp-for="Password" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
            <span asp-validation-for="Password" class="text-xs text-red-600"></span>
        </div>
        <div>
            <label asp-for="ConfirmPassword" class="mb-1 block text-sm font-medium text-slate-700"></label>
            <input asp-for="ConfirmPassword" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
            <span asp-validation-for="ConfirmPassword" class="text-xs text-red-600"></span>
        </div>
        <button type="submit" class="w-full rounded-lg bg-tripay-700 py-2 text-sm font-semibold text-white hover:bg-tripay-800">Kaydet</button>
    </form>
</div>
