@model OutboxDetailDto
<span data-admin-module="outbox.details" class="hidden" aria-hidden="true"></span>
<h1 class="sr-only">Outbox #@Model.Id</h1>

<a asp-action="Index" data-admin-ajax-link class="mb-4 inline-block text-sm text-tripay-700 hover:underline">← Outbox</a>

<div class="rounded-xl border border-slate-200 bg-white p-5 text-sm">
    <dl class="grid gap-2 sm:grid-cols-2">
        <div><dt class="text-slate-500">İşlem id</dt><dd class="font-medium">@Model.TransactionId</dd></div>
        <div><dt class="text-slate-500">Routing key</dt><dd class="font-mono">@Model.RoutingKey</dd></div>
        <div><dt class="text-slate-500">Yayınlandı</dt><dd>@(Model.IsPublished ? "Evet" : "Hayır")</dd></div>
        <div><dt class="text-slate-500">Deneme</dt><dd>@Model.RetryCount</dd></div>
        <div><dt class="text-slate-500">Oluşturulma</dt><dd>@Model.CreatedAt.ToLocalTime().ToString("G")</dd></div>
        <div><dt class="text-slate-500">Yayınlanma</dt><dd>@(Model.PublishedAt?.ToLocalTime().ToString("G") ?? "-")</dd></div>
    </dl>
    <p class="mb-2 mt-6 text-xs font-medium text-slate-600">Payload</p>
    <pre class="max-h-96 overflow-auto rounded-lg bg-slate-50 p-3 text-xs">@Model.Payload</pre>
</div>

<form asp-action="Requeue" asp-route-id="@Model.Id" method="post" data-admin-ajax="json"
      data-admin-confirm="Mesaj yeniden kuyruğa alınsın mı? (yayın durumu sıfırlanır)">
    @Html.AntiForgeryToken()
    <button type="submit" class="mt-4 rounded-lg border border-amber-300 bg-amber-50 px-4 py-2 text-sm font-medium text-amber-900 hover:bg-amber-100">
        Yeniden kuyruğa al
    </button>
</form>
