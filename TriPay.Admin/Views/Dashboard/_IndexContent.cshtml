@model DashboardViewModel
<h1 class="sr-only">Dashboard</h1>

<div class="mb-6 flex flex-wrap items-center gap-4 rounded-xl border border-slate-200 bg-white p-4 text-sm">
    <span class="font-medium text-slate-700">Sistem:</span>
    <span class="@(Model.DatabaseOk ? "text-emerald-700" : "text-red-700")">Veritabanı @(Model.DatabaseOk ? "OK" : "Hata")</span>
    <span class="@(Model.RedisOk ? "text-emerald-700" : "text-amber-700")">Redis @(Model.RedisOk ? "OK" : "Kapalı / bellek içi")</span>
</div>

<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
    <a asp-controller="Transactions" asp-action="Index" data-admin-ajax-link class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-tripay-600">
        <p class="text-sm font-medium text-slate-500">Toplam işlem</p>
        <p class="mt-2 text-3xl font-bold text-slate-900">@Model.TransactionCount</p>
    </a>
    <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-5">
        <p class="text-sm font-medium text-emerald-700">Başarılı</p>
        <p class="mt-2 text-3xl font-bold text-emerald-900">@Model.SuccessCount</p>
    </div>
    <div class="rounded-xl border border-red-200 bg-red-50 p-5">
        <p class="text-sm font-medium text-red-700">Başarısız</p>
        <p class="mt-2 text-3xl font-bold text-red-900">@Model.FailedCount</p>
    </div>
    <a asp-controller="Outbox" asp-action="Index" asp-route-unpublishedOnly="true" data-admin-ajax-link class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm hover:border-tripay-600">
        <p class="text-sm font-medium text-slate-500">Bekleyen outbox</p>
        <p class="mt-2 text-3xl font-bold text-slate-900">@Model.PendingOutboxCount</p>
    </a>
    <a asp-controller="Merchants" asp-action="Index" data-admin-ajax-link class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm hover:border-tripay-600">
        <p class="text-sm font-medium text-slate-500">Üye işyeri</p>
        <p class="mt-2 text-3xl font-bold text-slate-900">@Model.MerchantCount</p>
    </a>
    <a asp-controller="Gateways" asp-action="Index" data-admin-ajax-link class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm hover:border-tripay-600">
        <p class="text-sm font-medium text-slate-500">Ödeme kanalı</p>
        <p class="mt-2 text-3xl font-bold text-slate-900">@Model.GatewayCount</p>
    </a>
</div>
