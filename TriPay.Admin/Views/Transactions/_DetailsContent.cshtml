@model TransactionDetailViewModel
<h1 class="sr-only">İşlem #@Model.Id</h1>

<div class="mb-4">
    <a asp-action="Index" data-admin-ajax-link class="text-sm font-medium text-tripay-700 hover:underline">← İşlem listesi</a>
</div>

<div class="grid gap-6 lg:grid-cols-2">
    <div class="rounded-xl border border-slate-200 bg-white p-5 text-sm">
        <h2 class="mb-4 font-semibold text-slate-800">Özet</h2>
        <dl class="space-y-2">
            <div class="flex justify-between"><dt class="text-slate-500">Sipariş</dt><dd class="font-medium">@Model.OrderNumber</dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">Üye işyeri</dt><dd>@Model.MerchantName</dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">Kanal</dt><dd>@Model.GatewayCode</dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">Tutar</dt><dd>@Model.Amount.ToString("N2") @Model.Currency</dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">Durum</dt><dd>@{ ViewData["Status"] = Model.Status; }<partial name="_StatusBadge" /></dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">Banka işlem id</dt><dd>@(Model.ExternalTransactionId ?? "-")</dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">Yanıt</dt><dd>@(Model.ResponseCode ?? "-") @(Model.ResponseMessage)</dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">IP</dt><dd>@(Model.ClientIp ?? "-")</dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">Oluşturulma</dt><dd>@Model.CreatedAt.ToLocalTime().ToString("G")</dd></div>
        </dl>
    </div>
    <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-xs text-amber-900">
        Loglar maskelidir; PAN/CVV gösterilmez. Ham credential panelde düzenlenmez.
    </div>
</div>

<h2 class="mb-3 mt-8 text-lg font-semibold text-slate-800">API logları (@Model.Logs.Count)</h2>
<div class="space-y-4">
    @foreach (var log in Model.Logs)
    {
        <div class="rounded-xl border border-slate-200 bg-white p-4 text-sm">
            <div class="mb-2 flex flex-wrap gap-3 text-xs text-slate-500">
                <span class="font-semibold text-slate-700">@log.LogType</span>
                <span>@log.Direction</span>
                <span>@log.CreatedAt.ToLocalTime().ToString("G")</span>
                @if (log.HttpStatusCode.HasValue) { <span>HTTP @log.HttpStatusCode</span> }
            </div>
            @if (!string.IsNullOrEmpty(log.RequestPayload))
            {
                <p class="mb-1 text-xs font-medium text-slate-600">İstek (maskeli)</p>
                <pre class="max-h-40 overflow-auto rounded-lg bg-slate-50 p-2 text-xs">@log.RequestPayload</pre>
            }
            @if (!string.IsNullOrEmpty(log.ResponsePayload))
            {
                <p class="mb-1 mt-2 text-xs font-medium text-slate-600">Cevap</p>
                <pre class="max-h-40 overflow-auto rounded-lg bg-slate-50 p-2 text-xs">@log.ResponsePayload</pre>
            }
        </div>
    }
</div>
