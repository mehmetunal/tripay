@model IReadOnlyList<GatewaySettingListDto>
@{
    var gateway = ViewBag.Gateway as GatewayContextDto;
    ViewData["Title"] = $"{gateway?.Code} — Ayarlar";
}
<partial name="_SettingsContent" model="Model" />
@section Scripts {
    @await Html.PartialAsync("_AdminScripts", new[] { "~/js/modules/gateways/gateways.settings.module.js" })
}
