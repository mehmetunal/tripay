@model IReadOnlyList<GatewayErrorListDto>
@{
    var gateway = ViewBag.Gateway as GatewayContextDto;
    ViewData["Title"] = $"{gateway?.Code} — Hata sözlüğü";
}
<partial name="_ErrorsContent" model="Model" />
@section Scripts {
    @await Html.PartialAsync("_AdminScripts", new[] { "~/js/modules/gateways/gateways.errors.module.js" })
}
