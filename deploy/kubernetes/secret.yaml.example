# Örnek Secret — gerçek değerleri commit ETMEYİN.
# kubectl create secret generic tripay-secrets -n tripay --from-env-file=.env.prod
# veya External Secrets Operator + Azure Key Vault kullanın.
apiVersion: v1
kind: Secret
metadata:
  name: tripay-secrets
  namespace: tripay
type: Opaque
stringData:
  ConnectionStrings__Redis: "tripay-redis:6379,password=CHANGE_ME,ssl=True"
  ConnectionStrings__DefaultConnection: "Server=tripay-mssql;Database=TriPay;User Id=tripay_app;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=False"
  TriPay__RabbitMq__Host: "tripay-rabbitmq"
  TriPay__RabbitMq__Username: "tripay"
  TriPay__RabbitMq__Password: "CHANGE_ME"
  TriPay__Gateways__VakifPays__Settings__MerchantPassword: "CHANGE_ME"
  TriPay__Gateways__Iyzico__Settings__SecretKey: "CHANGE_ME"
