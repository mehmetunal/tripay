<Project>
  <!-- Tüm projeler için ortak MSBuild ayarları -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- NuGet kütüphanesi: .NET 8, 9, 10 ve üzeri (ileri SDK sürümleri net8.0 asset ile uyumludur) -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'TriPay.Core' Or '$(MSBuildProjectName)' == 'TriPay.Services' Or '$(MSBuildProjectName)' == 'TriPay.Data' Or '$(MSBuildProjectName)' == 'TriPay.Infrastructure' Or '$(MSBuildProjectName)' == 'TriPay.Persistence'">
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <!-- Demo / web örneği -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'TriPay.Core' And '$(MSBuildProjectName)' != 'TriPay.Services' And '$(MSBuildProjectName)' != 'TriPay.Data' And '$(MSBuildProjectName)' != 'TriPay.Infrastructure' And '$(MSBuildProjectName)' != 'TriPay.Persistence'">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- NuGet: kütüphane projeleri -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'TriPay.Core' Or '$(MSBuildProjectName)' == 'TriPay.Services' Or '$(MSBuildProjectName)' == 'TriPay.Data' Or '$(MSBuildProjectName)' == 'TriPay.Infrastructure' Or '$(MSBuildProjectName)' == 'TriPay.Persistence'">
    <IsTriPayNuGetLibrary>true</IsTriPayNuGetLibrary>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)build\TriPay.NuGet.Common.props"
          Condition="'$(IsTriPayNuGetLibrary)' == 'true'" />
  <Import Project="$(MSBuildThisFileDirectory)build\TriPay.NuGet.PackageIds.props"
          Condition="'$(IsTriPayNuGetLibrary)' == 'true'" />
  <Import Project="$(MSBuildThisFileDirectory)build\TriPay.NuGet.Docs.props"
          Condition="'$(IsTriPayNuGetLibrary)' == 'true'" />
</Project>
