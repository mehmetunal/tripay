@model TriPay.Services.Providers.VakifPays.Models.PaymentRequest
@{
    ViewData["Title"] = "Güvenli Ödeme";
    ViewData["CheckoutPage"] = true;
    var gateway = ViewData["Gateway"] as CheckoutGatewaySnapshot;
}

<div class="checkout-shell">
    <div class="checkout-layout">
        <aside class="checkout-summary" aria-label="Ödeme özeti">
            <div class="checkout-summary-brand">
                <div class="checkout-summary-logo" aria-hidden="true">TP</div>
                <span>TriPay</span>
            </div>
            @if (gateway is not null)
            {
                <div class="checkout-provider" aria-label="Ödeme kanalı">
                    <p class="checkout-provider-label">Ödeme kanalı</p>
                    <p class="checkout-provider-name">@gateway.ActiveDisplayName</p>
                    <p class="checkout-provider-code"><code>@gateway.ActiveCode</code></p>
                    <div class="checkout-provider-badges">
                        @if (gateway.IsEnabled)
                        {
                            <span class="checkout-provider-badge checkout-provider-badge-active">Aktif</span>
                        }
                        else
                        {
                            <span class="checkout-provider-badge checkout-provider-badge-warn">Yapılandırma kapalı</span>
                        }
                        <span class="checkout-provider-badge">@(gateway.IsTestMode ? "Test ortamı" : "Canlı ortam")</span>
                    </div>
                    @if (gateway.EnabledGateways.Count > 1)
                    {
                        <p class="checkout-provider-others-label">Diğer açık kanallar</p>
                        <ul class="checkout-provider-others">
                            @foreach (var g in gateway.EnabledGateways.Where(x => !x.IsActive))
                            {
                                <li><span>@g.DisplayName</span> <code class="small">@g.Code</code></li>
                            }
                        </ul>
                    }
                </div>
            }
            <div class="checkout-summary-amount">
                <label>Ödenecek tutar</label>
                <div>
                    <span class="amount-value">@Model.Amount.ToString("N2")</span>
                    <span class="amount-currency">@Model.Currency</span>
                </div>
            </div>
            <ul class="checkout-trust-list">
                <li>
                    <span class="checkout-trust-icon" aria-hidden="true">✓</span>
                    3D Secure ile doğrulanmış ödeme
                </li>
                <li>
                    <span class="checkout-trust-icon" aria-hidden="true">✓</span>
                    Kart bilgisi kalıcı saklanmaz
                </li>
                <li>
                    <span class="checkout-trust-icon" aria-hidden="true">✓</span>
                    TLS ile şifreli bağlantı
                </li>
            </ul>
            <span class="checkout-mode-pill">Framework demo</span>
        </aside>

        <div class="checkout-card">
            <div class="checkout-card-header">
                <h1>Güvenli kart ödemesi</h1>
                <p>Ödeme bilgilerinizi girin; bankanızın 3D Secure ekranına yönlendirileceksiniz.</p>
            </div>

            <div class="checkout-framework-note" role="status">
                <strong>Framework modu:</strong> Ödeme <code>IPaymentGatewayService</code> ile başlatılır;
                sipariş özeti demo uygulamanızda tutulur. TriPay MSSQL kullanılmaz.
            </div>

            <div class="checkout-card-body">
                <form asp-action="Pay" method="post" class="checkout-form">
                    <p class="checkout-section-title">Kart bilgileri</p>

                    <div class="checkout-field">
                        <label asp-for="CardOwner">Kart Üzerindeki İsim</label>
                        <input asp-for="CardOwner" type="text" value="MEHMET UNAL" required />
                    </div>

                    <div class="checkout-field checkout-field-card">
                        <label asp-for="CardNumber">Kart Numarası</label>
                        <input asp-for="CardNumber" id="cardNumber" type="text" value="5404355404355405" required />
                    </div>

                    <div class="checkout-grid">
                        <div class="checkout-field">
                            <label asp-for="ExpiryMonth">Ay</label>
                            <input asp-for="ExpiryMonth" type="text" value="12" maxlength="2" required />
                        </div>
                        <div class="checkout-field">
                            <label asp-for="ExpiryYear">Yıl</label>
                            <input asp-for="ExpiryYear" type="text" value="2030" maxlength="4" required />
                        </div>
                        <div class="checkout-field">
                            <label asp-for="Cvv">CVV</label>
                            <input asp-for="Cvv" type="text" value="001" maxlength="4" required />
                        </div>
                    </div>

                    <p class="checkout-section-title">Taksit</p>

                    <div class="checkout-field">
                        <label for="installmentSelect">Taksit Seçimi</label>
                        <select id="installmentSelect" asp-for="InstallmentCount">
                            <option value="1">1 (Tek Çekim)</option>
                        </select>
                        <small id="installmentHint" class="checkout-hint">Kart numarasına göre taksit seçenekleri otomatik gelir.</small>
                    </div>

                    <input asp-for="Amount" type="hidden" />
                    <input asp-for="Currency" type="hidden" />
                    <input asp-for="OrderNumber" type="hidden" />
                    <input asp-for="CustomerId" type="hidden" />
                    <input asp-for="CustomerName" type="hidden" />
                    <input asp-for="CustomerEmail" type="hidden" />
                    <input asp-for="CustomerIp" type="hidden" />
                    <input asp-for="CustomerPhone" type="hidden" />
                    <input asp-for="ReturnUrl" type="hidden" />
                    <input asp-for="BillToAddressLine" type="hidden" />
                    <input asp-for="BillToCity" type="hidden" />
                    <input asp-for="BillToCountry" type="hidden" />
                    <input asp-for="BillToPostalCode" type="hidden" />
                    <input asp-for="BillToPhone" type="hidden" />
                    <input asp-for="ShipToAddressLine" type="hidden" />
                    <input asp-for="ShipToCity" type="hidden" />
                    <input asp-for="ShipToCountry" type="hidden" />
                    <input asp-for="ShipToPostalCode" type="hidden" />
                    <input asp-for="ShipToPhone" type="hidden" />

                    <button type="submit" class="checkout-submit">
                        <span class="checkout-submit-icon" aria-hidden="true">🔒</span>
                        3D Secure ile Ödemeye Devam Et
                    </button>

                    <div class="checkout-badges">
                        <span class="checkout-badge-item">Visa</span>
                        <span class="checkout-badge-item">Mastercard</span>
                        <span class="checkout-badge-item">3D Secure</span>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const cardInput = document.getElementById("cardNumber");
    const installmentSelect = document.getElementById("installmentSelect");
    const amountInput = document.getElementById("Amount");
    const installmentHint = document.getElementById("installmentHint");

    function fillInstallments(items) {
        installmentSelect.innerHTML = "";
        items.forEach(i => {
            const option = document.createElement("option");
            option.value = i.count;
            option.textContent = i.label || `${i.count} Taksit`;
            installmentSelect.appendChild(option);
        });
        const selected = items.find(x => x.count === Number(installmentSelect.value)) || items[0];
        if (selected) installmentHint.textContent = `Vade farkı: %${Number(selected.rate || 0).toFixed(2)} | Toplam: ${Number(selected.total || 0).toFixed(2)} TL | Aylık: ${Number(selected.monthly || 0).toFixed(2)} TL`;
    }

    async function loadInstallments() {
        const cardNumber = (cardInput.value || "").replace(/\s/g, "");
        if (cardNumber.length < 6) {
            fillInstallments([{ count: 1, rate: 0, total: Number(amountInput.value || 0), monthly: Number(amountInput.value || 0), label: "1 (Tek Çekim)" }]);
            return;
        }

        try {
            const response = await fetch(`/Checkout/Installments?cardNumber=${encodeURIComponent(cardNumber)}&amount=${encodeURIComponent(amountInput.value || "0")}`);
            const data = await response.json();
            if (data.success && Array.isArray(data.installments) && data.installments.length > 0) {
                fillInstallments(data.installments);
            } else {
                fillInstallments([{ count: 1, rate: 0, total: Number(amountInput.value || 0), monthly: Number(amountInput.value || 0), label: "1 (Tek Çekim)" }]);
            }
        } catch {
            fillInstallments([{ count: 1, rate: 0, total: Number(amountInput.value || 0), monthly: Number(amountInput.value || 0), label: "1 (Tek Çekim)" }]);
        }
    }

    cardInput.addEventListener("input", loadInstallments);
    installmentSelect.addEventListener("change", () => {
        const selected = installmentSelect.options[installmentSelect.selectedIndex];
        if (selected) installmentHint.textContent = selected.textContent;
    });
    loadInstallments();
</script>
}
