<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - TriPay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/checkout.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/TriPay.styles.css" asp-append-version="true"/>
    <style>
        body { font-family: Inter, system-ui, sans-serif; }
    </style>
</head>
<body class="@(ViewData["CheckoutPage"] as bool? == true ? "checkout-body" : "")">
<header>
    <nav class="navbar navbar-expand-sm demo-navbar @(ViewData["CheckoutPage"] as bool? == true ? "mb-0" : "mb-3")">
        <div class="container-fluid px-3 px-lg-4">
            <a class="navbar-brand" href="https://tripay.com.tr" target="_blank" rel="noopener">TriPay</a>
            <span class="badge badge-framework ms-2 align-middle">Framework demo</span>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#demoNav"
                    aria-controls="demoNav" aria-expanded="false" aria-label="Menü">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="demoNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" asp-controller="Checkout" asp-action="Index">Ödeme</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>

@if (ViewData["CheckoutPage"] as bool? == true)
{
    <main role="main">@RenderBody()</main>
}
else
{
    <div class="container">
        <main role="main" class="pb-3">@RenderBody()</main>
    </div>
}

@if (ViewData["CheckoutPage"] as bool? != true)
{
    <footer class="border-top footer text-muted">
        <div class="container py-3">
            &copy; @DateTime.Now.Year -
            <a href="https://tripay.com.tr" target="_blank" rel="noopener">tripay.com.tr</a>
        </div>
    </footer>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
