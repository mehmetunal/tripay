<div class="overflow-x-auto rounded-xl border border-slate-200">
    <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 font-semibold">
            <tr><th class="p-3">Kriter</th><th class="p-3">Framework</th><th class="p-3">Hosted</th></tr>
        </thead>
        <tbody class="divide-y text-ink-700">
            <tr><td class="p-3">Enjekte servis</td><td class="p-3"><code>IPaymentGatewayService</code></td><td class="p-3"><code>IPaymentCheckoutService</code></td></tr>
