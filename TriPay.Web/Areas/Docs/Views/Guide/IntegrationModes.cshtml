            <tr><td class="p-3">Kart formu</td><td class="p-3">Sizin UI</td><td class="p-3">TriPay /pay</td></tr>
            <tr><td class="p-3">Request/response kontrolü</td><td class="p-3">Tam (controller’da)</td><td class="p-3">Oturum + webhook odaklı</td></tr>
