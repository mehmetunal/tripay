<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Dokümantasyon") — TriPay Kılavuz</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/web.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-white">
    <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6">
            <a href="@SiteLinks.DocsPath" class="font-bold text-ink-950">TriPay <span class="text-brand-600">Docs</span></a>
            <div class="flex items-center gap-2 text-sm">
                <a href="@SiteLinks.Root" class="btn-ghost">Ana site</a>
                <a href="@SiteLinks.PayPath" class="btn-ghost">Ödeme</a>
                <a href="@(SiteLinks.DocsPath)/Kilavuz/GettingStarted" class="btn-primary">Hızlı başlangıç</a>
            </div>
        </div>
    </header>
    <div class="mx-auto flex max-w-7xl gap-0 px-4 sm:px-6 lg:gap-10">
        @await Html.PartialAsync("_DocSidebar")
        <main class="min-w-0 flex-1 py-10 lg:py-12">
            @if (ViewData["DocLead"] is string lead)
            {
                <p class="text-lg text-ink-600">@lead</p>
            }
            <article class="prose-doc mt-6 max-w-3xl">
                @RenderBody()
            </article>
        </main>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
