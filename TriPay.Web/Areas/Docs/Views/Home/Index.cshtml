@{
    ViewData["Title"] = "Dokümantasyon";
}
<h1 class="text-3xl font-bold text-ink-950">TriPay Dokümantasyon</h1>
<p class="mt-4 text-lg text-ink-600">Ödeme entegrasyonunu sıfırdan öğrenmek için adım adım kılavuz. Teknik sınıf veya metot adları yerine süreç ve kavram odaklı anlatım.</p>
<div class="mt-10 grid gap-4 sm:grid-cols-2">
    <a asp-controller="Kilavuz" asp-action="GettingStarted" class="card block transition hover:border-brand-300 hover:shadow-md">
        <h2 class="font-bold text-ink-950">Hızlı başlangıç</h2>
        <p class="mt-2 text-sm text-ink-600">İlk ödemenizi 5 adımda hayata geçirin.</p>
    </a>
    <a asp-controller="Kilavuz" asp-action="IntegrationModes" class="card block transition hover:border-brand-300">
        <h2 class="font-bold text-ink-950">Entegrasyon modları</h2>
        <p class="mt-2 text-sm text-ink-600">Framework, hosted ve panel — hangisi size uygun?</p>
    </a>
    <a asp-controller="Kilavuz" asp-action="PaymentFlow" class="card block transition hover:border-brand-300">
        <h2 class="font-bold text-ink-950">Ödeme akışı</h2>
        <p class="mt-2 text-sm text-ink-600">Sepetten 3D Secure’a, sonuç bildirimine kadar.</p>
    </a>
    <a asp-controller="Kilavuz" asp-action="Faq" class="card block transition hover:border-brand-300">
        <h2 class="font-bold text-ink-950">Sık sorulanlar</h2>
        <p class="mt-2 text-sm text-ink-600">KVKK, test ortamı, hata kodları.</p>
    </a>
</div>
