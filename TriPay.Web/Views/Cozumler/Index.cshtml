@{
    ViewData["Title"] = "Çözümler";
}
<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="section-title">Sektöre göre çözümler</h1>
    <p class="section-lead">E-ticaret, pazaryeri ve SaaS ekipleri için aynı hub, farklı dağıtım modelleri.</p>
    <div class="mt-12 space-y-8">
        <article class="card flex flex-col gap-4 lg:flex-row lg:items-start">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-100 text-brand-800 font-bold">E</div>
            <div>
                <h2 class="text-xl font-bold">E-ticaret</h2>
                <p class="mt-2 text-ink-600">Sepet → ödeme başlat → 3D → sipariş güncelle. Kendi sitenizde tam kontrol; müşteri verisi sizin sunucunuzda.</p>
            </div>
        </article>
        <article class="card flex flex-col gap-4 lg:flex-row lg:items-start">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-100 text-brand-800 font-bold">P</div>
            <div>
                <h2 class="text-xl font-bold">Pazaryeri</h2>
                <p class="mt-2 text-ink-600">Satıcı bazında farklı banka anlaşmaları; her satıcı için ayrı ödeme kanalı seçimi ve merkezi raporlama.</p>
            </div>
        </article>
        <article class="card flex flex-col gap-4 lg:flex-row lg:items-start">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-100 text-brand-800 font-bold">S</div>
            <div>
                <h2 class="text-xl font-bold">SaaS ve abonelik</h2>
                <p class="mt-2 text-ink-600">Tekrarlayan tahsilat senaryolarında durum sorgulama ve webhook ile abonelik durumunu güncelleme.</p>
            </div>
        </article>
    </div>
</section>
