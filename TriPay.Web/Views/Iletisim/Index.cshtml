@model TriPay.Web.Models.ContactFormModel
@{
    ViewData["Title"] = "İletişim";
}
<section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="section-title">İletişim</h1>
    <p class="section-lead">Entegrasyon, iş ortaklığı veya teknik sorularınız için formu doldurun.</p>
    <form asp-action="Index" method="post" class="card mt-10 space-y-5">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800"></div>
        <div>
            <label asp-for="AdSoyad" class="block text-sm font-medium text-ink-800"></label>
            <input asp-for="AdSoyad" class="mt-1 w-full rounded-xl border border-slate-300 px-4 py-2.5 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20" />
            <span asp-validation-for="AdSoyad" class="text-sm text-red-600"></span>
        </div>
        <div>
            <label asp-for="Eposta" class="block text-sm font-medium text-ink-800"></label>
            <input asp-for="Eposta" class="mt-1 w-full rounded-xl border border-slate-300 px-4 py-2.5 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20" />
            <span asp-validation-for="Eposta" class="text-sm text-red-600"></span>
        </div>
        <div>
            <label asp-for="Sirket" class="block text-sm font-medium text-ink-800"></label>
            <input asp-for="Sirket" class="mt-1 w-full rounded-xl border border-slate-300 px-4 py-2.5" />
        </div>
        <div>
            <label asp-for="Konu" class="block text-sm font-medium text-ink-800"></label>
            <select asp-for="Konu" class="mt-1 w-full rounded-xl border border-slate-300 px-4 py-2.5">
                <option value="entegrasyon">Entegrasyon</option>
                <option value="hosted">Hosted ödeme</option>
                <option value="ortaklik">İş ortaklığı</option>
                <option value="diger">Diğer</option>
            </select>
        </div>
        <div>
            <label asp-for="Mesaj" class="block text-sm font-medium text-ink-800"></label>
            <textarea asp-for="Mesaj" rows="5" class="mt-1 w-full rounded-xl border border-slate-300 px-4 py-2.5"></textarea>
            <span asp-validation-for="Mesaj" class="text-sm text-red-600"></span>
        </div>
        <button type="submit" class="btn-primary w-full sm:w-auto">Gönder</button>
    </form>
    <p class="mt-6 text-sm text-ink-500">E-posta: <a href="mailto:@SiteLinks.ContactEmail" class="text-brand-700">@SiteLinks.ContactEmail</a></p>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
