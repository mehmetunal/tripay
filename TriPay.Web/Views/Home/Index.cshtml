@{
    ViewData["Title"] = "Ana Sayfa";
    ViewData["Description"] = "TriPay Payment Hub: sanal POS ve ödeme kuruluşlarını tek .NET katmanında birleştirin. KVKK dostu framework, hosted ödeme ve yönetim paneli.";
}
<section class="relative overflow-hidden bg-gradient-to-br from-ink-950 via-ink-900 to-brand-900">
    <div class="page-hero-glow" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
        <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
            <div>
                <span class="badge bg-brand-500/20 text-brand-100 ring-brand-400/40">Payment Hub · ASP.NET Core 8</span>
                <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
                    Ödeme entegrasyonunu tek yerde toplayın
                </h1>
                <p class="mt-6 text-lg leading-relaxed text-slate-300 sm:text-xl">
                    Banka sanal POS, 3D Secure ve ödeme kuruluşu API’lerini tek, tutarlı .NET arayüzünde birleştirin.
                    Veriyi kendi sunucunuzda tutun veya hosted ödeme ile hızlı canlıya çıkın — kontrol sizde.
                </p>
                <ul class="mt-8 space-y-3 text-sm text-slate-300">
                    <li class="flex items-start gap-3">
                        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-500/30 text-brand-200">✓</span>
                        Banka sözleşmesi ve komisyon doğrudan sizin bankanızla; TriPay aracı değil, entegrasyon katmanıdır.
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-500/30 text-brand-200">✓</span>
                        Framework modunda müşteri ve işlem verisi kendi MSSQL’inizde; merkezi kart deposu yok.
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-500/30 text-brand-200">✓</span>
                        Üretim için 3D, taksit, iade, imzalı webhook ve operasyon paneli hazır.
                    </li>
                </ul>
                <div class="mt-10 flex flex-wrap gap-4">
                    <a href="@SiteLinks.DocsPath/Guide/GettingStarted" class="btn-primary bg-brand-500 hover:bg-brand-400">5 dakikada başlayın</a>
                    <a asp-controller="Contact" asp-action="Index" class="btn-outline-light">Demo ve teklif alın</a>
                </div>
            </div>
            <div class="mock-panel lg:ml-auto lg:max-w-md" aria-hidden="true">
                <div class="flex items-center justify-between border-b border-slate-700 pb-3">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Canlı işlem özeti</span>
                    <span class="rounded-full bg-emerald-500/20 px-2 py-0.5 text-xs font-medium text-emerald-300">Aktif</span>
                </div>
                <dl class="mt-4 space-y-3 text-sm">
                    <div class="flex justify-between gap-4">
                        <dt class="text-slate-400">Son işlem</dt>
                        <dd class="font-mono text-slate-200">#TRP-28491</dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-slate-400">Tutar</dt>
                        <dd class="font-semibold text-white">12.450,00 ₺</dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-slate-400">Kanal</dt>
                        <dd class="text-slate-200">Sanal POS · 3D</dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-slate-400">Durum</dt>
                        <dd class="text-emerald-400">Onaylandı</dd>
                    </div>
                </dl>
                <div class="mt-5 rounded-xl bg-ink-950/80 p-3 text-xs text-slate-400">
                    Webhook doğrulandı · Sipariş güncellendi · 1,2 sn
                </div>
            </div>
        </div>
    </div>
</section>

<section class="trust-strip">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
            <div class="text-center">
                <p class="stat-value">3</p>
                <p class="stat-label">Entegrasyon modu</p>
            </div>
            <div class="text-center">
                <p class="stat-value">%100</p>
                <p class="stat-label">.NET odaklı mimari</p>
            </div>
            <div class="text-center">
                <p class="stat-value">KVKK</p>
                <p class="stat-label">Veri konumu seçeneği</p>
            </div>
            <div class="text-center">
                <p class="stat-value">7/24</p>
                <p class="stat-label">Webhook ve outbox</p>
            </div>
        </div>
    </div>
</section>

<section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <p class="text-center text-sm font-semibold uppercase tracking-wider text-brand-700">Neden TriPay?</p>
    <h2 class="section-title mt-2 text-center">Parçalanmış ödeme API’lerine tek cevap</h2>
    <p class="mx-auto mt-4 max-w-2xl text-center text-ink-600">
        Her yeni banka veya kuruluş ayrı dokümantasyon, ayrı callback ve ayrı hata kodu demek.
        TriPay bu farkları tek ödeme deneyiminin arkasına alır; ekibiniz iş kurallarına odaklanır.
    </p>
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="card">
            <div class="icon-feature">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
            </div>
            <h3 class="mt-4 text-lg font-bold text-ink-950">Banka sözleşmeniz sizde</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">TriPay banka veya ödeme kuruluşu değildir. Terminal, üye işyeri ve komisyon ilişkisi doğrudan sizin anlaşmanızla yürür.</p>
        </div>
        <div class="card">
            <div class="icon-feature">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            </div>
            <h3 class="mt-4 text-lg font-bold text-ink-950">KVKK’ya uygun dağıtım</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">Framework modunda müşteri ve işlem kayıtları kendi veritabanınızda kalır; kart numarası kalıcı olarak saklanmaz.</p>
        </div>
        <div class="card">
            <div class="icon-feature">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <h3 class="mt-4 text-lg font-bold text-ink-950">Hızlı canlıya çıkış</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">Hosted ödeme sayfası ile PCI yüzeyini küçültün; backend’iniz yalnızca yönlendirme ve sonuç bildirimi yönetsin.</p>
        </div>
        <div class="card">
            <div class="icon-feature">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/></svg>
            </div>
            <h3 class="mt-4 text-lg font-bold text-ink-950">Çoklu gateway</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">Üye işyeri veya kanal bazında farklı sanal POS ve kuruluş seçimi; aynı sipariş akışı, farklı arka uçlar.</p>
        </div>
        <div class="card">
            <div class="icon-feature">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            </div>
            <h3 class="mt-4 text-lg font-bold text-ink-950">Operasyonel görünürlük</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">İşlem listesi, gateway hataları, outbox kuyruğu ve raporlar yönetim panelinde; ekip tek ekrandan izler.</p>
        </div>
        <div class="card">
            <div class="icon-feature">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
            </div>
            <h3 class="mt-4 text-lg font-bold text-ink-950">Test edilebilir mimari</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">Clean Architecture, CQRS ve birim testleri ile ödeme mantığı öngörülebilir; regresyon riski düşer.</p>
        </div>
    </div>
</section>

<section class="bg-slate-100/80 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="section-title text-center">Dört adımda canlı ödeme</h2>
        <p class="section-lead mx-auto text-center">İster kendi uygulamanızda ister hosted sayfada — akış aynı iş kurallarına dayanır.</p>
        <ol class="mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
            <li class="card">
                <span class="step-number">1</span>
                <h3 class="mt-4 font-bold text-ink-950">Kanalı tanımlayın</h3>
                <p class="mt-2 text-sm text-ink-600">Banka veya kuruluş bilgilerini panel veya yapılandırma ile girin; test ortamında doğrulayın.</p>
            </li>
            <li class="card">
                <span class="step-number">2</span>
                <h3 class="mt-4 font-bold text-ink-950">Ödemeyi başlatın</h3>
                <p class="mt-2 text-sm text-ink-600">Sipariş kimliği ve tutar ile ödeme oturumu oluşturun; müşteriyi 3D adımına yönlendirin.</p>
            </li>
            <li class="card">
                <span class="step-number">3</span>
                <h3 class="mt-4 font-bold text-ink-950">Sonucu doğrulayın</h3>
                <p class="mt-2 text-sm text-ink-600">Bankadan dönen yanıt imza ve durum kodlarıyla kontrol edilir; kart verisi loglanmaz.</p>
            </li>
            <li class="card">
                <span class="step-number">4</span>
                <h3 class="mt-4 font-bold text-ink-950">Sisteminizi güncelleyin</h3>
                <p class="mt-2 text-sm text-ink-600">Webhook veya callback ile sipariş, stok ve fatura süreçlerinizi otomatik senkronize edin.</p>
            </li>
        </ol>
    </div>
</section>

<section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <h2 class="section-title text-center">Size uygun entegrasyon modeli</h2>
    <p class="section-lead mx-auto text-center">Veri konumu, operasyon yükü ve go-live süresine göre seçin.</p>
    <div class="mt-14 grid gap-8 lg:grid-cols-3">
        <article class="card border-brand-200 ring-2 ring-brand-500/20">
            <span class="badge">Önerilen</span>
            <h3 class="mt-4 text-xl font-bold text-ink-950">Framework (NuGet)</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">Ödeme mantığı kendi ASP.NET Core uygulamanızda. Müşteri verisi ve işlem kayıtları sizin MSSQL’inizde.</p>
            <ul class="mt-4 space-y-2 text-sm text-ink-600">
                <li>· Tam KVKK kontrolü</li>
                <li>· Özelleştirilebilir checkout</li>
                <li>· Birim testleri ve CI/CD uyumu</li>
            </ul>
            <a href="@SiteLinks.DocsPath/Guide/IntegrationModes" class="mt-6 inline-block text-sm font-semibold text-brand-700 hover:text-brand-800">Mod detayları →</a>
        </article>
        <article class="card">
            <h3 class="text-xl font-bold text-ink-950">Hosted ödeme</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">Ödeme sayfası TriPay tarafından sunulur; siz sipariş ve sonuç bildirimini yönetirsiniz.</p>
            <ul class="mt-4 space-y-2 text-sm text-ink-600">
                <li>· En hızlı canlıya çıkış</li>
                <li>· Küçük PCI yüzeyi</li>
                <li>· Mobil uyumlu sayfa</li>
            </ul>
            <a href="@SiteLinks.PayPath" class="mt-6 inline-block text-sm font-semibold text-brand-700 hover:text-brand-800">Hosted modül →</a>
        </article>
        <article class="card">
            <h3 class="text-xl font-bold text-ink-950">Yönetim paneli</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">Çoklu üye işyeri, işlem izleme, gateway ayarları ve raporlar tek operasyon yüzünde.</p>
            <ul class="mt-4 space-y-2 text-sm text-ink-600">
                <li>· Rol ve izin yönetimi</li>
                <li>· İade ve iptal takibi</li>
                <li>· Sistem durumu ve outbox</li>
            </ul>
            <a href="@SiteLinks.AdminPath" class="mt-6 inline-block text-sm font-semibold text-brand-700 hover:text-brand-800">Panel bilgisi →</a>
        </article>
    </div>
    <p class="mt-10 text-center">
        <a asp-controller="Integration" asp-action="Index" class="font-semibold text-brand-700 hover:text-brand-800">Tüm modları karşılaştırın →</a>
    </p>
</section>

<section class="bg-slate-100/80 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
            <div>
                <h2 class="section-title">Kimler için?</h2>
                <p class="section-lead">E-ticaret, pazaryeri ve SaaS ekipleri aynı hub üzerinden farklı dağıtım modelleri kullanır.</p>
                <a asp-controller="Solutions" asp-action="Index" class="mt-6 inline-flex btn-primary">Sektör çözümlerini inceleyin</a>
            </div>
            <div class="space-y-4">
                <div class="card flex gap-4">
                    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-100 text-lg font-bold text-brand-800">E</span>
                    <div>
                        <h3 class="font-bold text-ink-950">E-ticaret</h3>
                        <p class="mt-1 text-sm text-ink-600">Sepet → ödeme → 3D → sipariş güncelleme; kampanya ve taksit kuralları sizin kontrolünüzde.</p>
                    </div>
                </div>
                <div class="card flex gap-4">
                    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-100 text-lg font-bold text-brand-800">P</span>
                    <div>
                        <h3 class="font-bold text-ink-950">Pazaryeri</h3>
                        <p class="mt-1 text-sm text-ink-600">Satıcı bazında farklı banka anlaşmaları ve merkezi raporlama tek panelde.</p>
                    </div>
                </div>
                <div class="card flex gap-4">
                    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-100 text-lg font-bold text-brand-800">S</span>
                    <div>
                        <h3 class="font-bold text-ink-950">SaaS ve abonelik</h3>
                        <p class="mt-1 text-sm text-ink-600">Tekrarlayan tahsilat ve webhook ile abonelik durumunu otomatik güncelleyin.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:px-8">
    <h2 class="section-title text-center">Sık sorulan sorular</h2>
    <div class="mt-10 space-y-4">
        <details class="faq-details">
            <summary>TriPay bir banka veya ödeme kuruluşu mu?</summary>
            <p>Hayır. TriPay, mevcut banka ve kuruluş sözleşmelerinizle çalışan bir entegrasyon katmanıdır. Komisyon ve hukuki ilişki bankanızla kalır.</p>
        </details>
        <details class="faq-details">
            <summary>Kart bilgileri nerede işlenir?</summary>
            <p>Framework modunda ödeme akışı sizin uygulamanızda yürür; PAN ve CVV kalıcı depoda tutulmaz. Hosted modda kart adımları TriPay ödeme sayfasında işlenir.</p>
        </details>
        <details class="faq-details">
            <summary>Ne kadar sürede canlıya çıkabilirim?</summary>
            <p>Hosted model ile birkaç gün içinde pilot mümkündür. Framework entegrasyonu, banka test onaylarına bağlı olarak genelde 2–4 hafta sürer.</p>
        </details>
        <details class="faq-details">
            <summary>Test ortamı var mı?</summary>
            <p>Evet. Geliştirme ve demo projeleri ile sandbox akışlarını deneyebilir; kılavuzdaki adımlarla ilk test ödemesini alabilirsiniz.</p>
        </details>
    </div>
    <p class="mt-8 text-center text-sm text-ink-600">
        Daha fazlası için <a href="@SiteLinks.DocsPath/Guide/Faq" class="font-semibold text-brand-700">kılavuz SSS bölümüne</a> bakın.
    </p>
</section>

@{
    ViewData["CtaTitle"] = "Pilot entegrasyonu planlayalım";
    ViewData["CtaLead"] = "Teknik ekibinizle 30 dakikalık görüşme veya sandbox erişimi için formu doldurun.";
    ViewData["CtaPrimaryText"] = "İletişim formu";
    ViewData["CtaPrimaryUrl"] = "/Contact";
    ViewData["CtaSecondaryText"] = "Kılavuzu aç";
    ViewData["CtaSecondaryUrl"] = SiteLinks.DocsPath;
}
@await Html.PartialAsync("_MarketingCta")
