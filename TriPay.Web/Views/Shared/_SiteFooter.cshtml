<footer class="border-t border-slate-200 bg-ink-950 text-slate-300">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-5 lg:px-8">
        <div class="lg:col-span-2">
            <p class="text-xl font-bold text-white">TriPay</p>
            <p class="mt-4 max-w-md text-sm leading-relaxed text-slate-400">
                Türkiye’deki sanal POS ve ödeme kuruluşlarını tek platformda birleştiren ödeme altyapısı.
                Banka sözleşmeniz ve müşteri veriniz sizde kalır; TriPay öngörülebilir entegrasyon sağlar.
            </p>
            <p class="mt-3 text-sm text-slate-500">
                TriPay,
                <a href="@SiteLinks.CompanyUrl" class="font-medium text-brand-400 hover:text-brand-300" target="_blank" rel="noopener">@SiteLinks.CompanyName</a>
                alt ürünüdür.
            </p>
            <p class="mt-4 text-sm">
                <a href="mailto:@SiteLinks.ContactEmail" class="font-medium text-brand-400 hover:text-brand-300">@SiteLinks.ContactEmail</a>
            </p>
        </div>
        <div>
            <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Ürün</p>
            <ul class="mt-4 space-y-2.5 text-sm">
                <li><a asp-area="" asp-controller="Product" asp-action="Index" class="hover:text-white">Özellikler</a></li>
                <li><a asp-area="" asp-controller="Integration" asp-action="Index" class="hover:text-white">Entegrasyon modları</a></li>
                <li><a asp-area="" asp-controller="Solutions" asp-action="Index" class="hover:text-white">Sektör çözümleri</a></li>
                <li><a href="@SiteLinks.PayPath" class="hover:text-white">Hosted ödeme</a></li>
            </ul>
        </div>
        <div>
            <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Geliştirici</p>
            <ul class="mt-4 space-y-2.5 text-sm">
                <li><a href="@SiteLinks.DocsPath" class="hover:text-white">Kullanım kılavuzu</a></li>
                <li><a href="@SiteLinks.DocsPath/Guide/GettingStarted" class="hover:text-white">Hızlı başlangıç</a></li>
                <li><a href="@SiteLinks.PayDemoUrl" class="hover:text-white" rel="noopener">Checkout demosu</a></li>
                <li><a href="@SiteLinks.AdminPath" class="hover:text-white">Yönetim paneli</a></li>
            </ul>
        </div>
        <div>
            <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Şirket</p>
            <ul class="mt-4 space-y-2.5 text-sm">
                <li><a asp-area="" asp-controller="Corporate" asp-action="About" class="hover:text-white">Hakkımızda</a></li>
                <li><a asp-area="" asp-controller="Security" asp-action="Index" class="hover:text-white">Güvenlik</a></li>
                <li><a asp-area="" asp-controller="Contact" asp-action="Index" class="hover:text-white">İletişim ve demo</a></li>
                <li><a href="@SiteLinks.CompanyUrl" class="hover:text-white" target="_blank" rel="noopener">@SiteLinks.CompanyName</a></li>
            </ul>
        </div>
    </div>
    <div class="border-t border-slate-800">
        <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-6 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
            <span>© @DateTime.Now.Year @SiteLinks.CompanyName · TriPay. Tüm hakları saklıdır.</span>
            <div class="flex flex-wrap gap-4">
                <a asp-area="" asp-controller="Legal" asp-action="Kvkk" class="hover:text-slate-300">KVKK</a>
                <a asp-area="" asp-controller="Legal" asp-action="Privacy" class="hover:text-slate-300">Gizlilik</a>
                <a asp-area="" asp-controller="Legal" asp-action="Cookies" class="hover:text-slate-300">Çerez</a>
            </div>
        </div>
    </div>
</footer>
