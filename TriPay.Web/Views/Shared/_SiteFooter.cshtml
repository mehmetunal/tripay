<footer class="border-t border-slate-200 bg-ink-950 text-slate-300">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 lg:grid-cols-4 lg:px-8">
        <div class="lg:col-span-2">
            <p class="text-lg font-bold text-white">TriPay</p>
            <p class="mt-3 max-w-md text-sm leading-relaxed text-slate-400">
                Türkiye’deki sanal POS ve ödeme kuruluşu API’lerini tek .NET arayüzünde birleştiren Payment Hub.
                Banka sözleşmeniz ve müşteri veriniz sizde kalır.
            </p>
        </div>
        <div>
            <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Ürün</p>
            <ul class="mt-4 space-y-2 text-sm">
                <li><a asp-controller="Urun" asp-action="Index" class="hover:text-white">Özellikler</a></li>
                <li><a asp-controller="Entegrasyon" asp-action="Index" class="hover:text-white">Entegrasyon modları</a></li>
                <li><a href="@SiteLinks.PayPath" class="hover:text-white">Hosted ödeme</a></li>
            </ul>
        </div>
        <div>
            <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Kaynaklar</p>
            <ul class="mt-4 space-y-2 text-sm">
                <li><a href="@SiteLinks.DocsPath" class="hover:text-white">Kullanım kılavuzu</a></li>
                <li><a href="@SiteLinks.AdminPath" class="hover:text-white">Yönetim paneli</a></li>
                <li><a asp-controller="Iletisim" asp-action="Index" class="hover:text-white">İletişim</a></li>
            </ul>
        </div>
    </div>
    <div class="border-t border-slate-800">
        <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-6 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
            <span>© @DateTime.Now.Year TriPay. Tüm hakları saklıdır.</span>
            <div class="flex flex-wrap gap-4">
                <a asp-controller="Yasal" asp-action="Kvkk" class="hover:text-slate-300">KVKK</a>
                <a asp-controller="Yasal" asp-action="Privacy" class="hover:text-slate-300">Gizlilik</a>
                <a asp-controller="Yasal" asp-action="Cookies" class="hover:text-slate-300">Çerez</a>
            </div>
        </div>
    </div>
</footer>
