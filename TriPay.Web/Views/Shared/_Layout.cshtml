<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "TriPay") — Tüm Ödemeler Tek Platformda</title>
    <meta name="description" content="@(ViewData["Description"] ?? "TriPay; sanal POS ve ödeme kuruluşlarını tek platformda birleştiren ödeme altyapısıdır.")" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/web.css" asp-append-version="true" />
</head>
<body class="min-h-screen flex flex-col">
    @await Html.PartialAsync("_MarketingHeader")
    <main class="flex-1">
        @RenderBody()
    </main>
    @await Html.PartialAsync("_SiteFooter")
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
