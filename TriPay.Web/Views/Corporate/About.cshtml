@{
    ViewData["Title"] = "Hakkımızda";
    ViewData["Description"] = "TriPay misyonu: Türkiye'de ödeme entegrasyonunu öngörülebilir ve güvenli hale getirmek.";
    ViewData["HeroTitle"] = "Ödeme entegrasyonunu öngörülebilir kılıyoruz";
    ViewData["HeroLead"] = "TriPay, Türkiye’deki parçalanmış ödeme kanallarına tek, güvenilir bir cevap vermek için geliştirilmiştir.";
    ViewData["HeroBadge"] = "Kurumsal";
    ViewData["HeroCompact"] = true;
}
@await Html.PartialAsync("_PageHero")

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
        <div class="prose-doc max-w-none">
            <p>
                Her banka ve ödeme kuruluşu farklı süreç, farklı geri dönüş ve farklı hata kodu sunar.
                E-ticaret ve operasyon ekipleri bu farkları her proje için yeniden öğrenmek zorunda kalır.
                TriPay bu karmaşıklığı tek, tutarlı bir ödeme deneyiminin arkasına alır.
            </p>
            <p>
                <strong>Banka değiliz.</strong> Üye işyerinin kendi sözleşmesi ve terminal bilgileriyle çalışırız.
                Komisyon ve hukuki ilişki doğrudan sizin bankanızla kalır; TriPay entegrasyon ve operasyon katmanıdır.
            </p>
            <h2>Misyon</h2>
            <p>Ödeme entegrasyonunu öngörülebilir, güvenli ve yönetilebilir hale getirmek; ekiplerin ürün ve müşteri deneyimine odaklanmasını sağlamak.</p>
            <h2>Vizyon</h2>
            <p>Türkiye’de ödeme altyapısında güvenilir iş ortağı olmak; yerli ve global ölçekte sürdürülebilir hizmet sunmak.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
            <div class="card text-center">
                <p class="stat-value">2019</p>
                <p class="stat-label">Kuruluş yılı</p>
            </div>
            <div class="card text-center">
                <p class="stat-value">3</p>
                <p class="stat-label">Entegrasyon modu</p>
            </div>
            <div class="card text-center">
                <p class="stat-value">7/24</p>
                <p class="stat-label">Operasyon desteği</p>
            </div>
            <div class="card text-center">
                <p class="stat-value">TR</p>
                <p class="stat-label">Yerel ödeme ekosistemi</p>
            </div>
        </div>
    </div>
</section>

<section class="bg-slate-100/80 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="section-title text-center">Değerlerimiz</h2>
        <div class="mt-12 grid gap-6 md:grid-cols-3">
            <div class="card">
                <h3 class="font-bold text-ink-950">Şeffaflık</h3>
                <p class="mt-2 text-sm text-ink-600">Veri nerede duruyor, kim işletiyor — entegrasyon modlarında net cevap veriyoruz.</p>
            </div>
            <div class="card">
                <h3 class="font-bold text-ink-950">Güven</h3>
                <p class="mt-2 text-sm text-ink-600">Kart verisi minimizasyonu ve doğrulanmış bildirimler tasarımın merkezinde.</p>
            </div>
            <div class="card">
                <h3 class="font-bold text-ink-950">Sürdürülebilirlik</h3>
                <p class="mt-2 text-sm text-ink-600">Uzun vadeli iş ortaklığı ve sürekli iyileştirme ile operasyon maliyetinizi düşürüyoruz.</p>
            </div>
        </div>
    </div>
</section>

@{
    ViewData["CtaTitle"] = "TriPay ile tanışın";
    ViewData["CtaLead"] = "Ürün turu ve iş görüşmesi için iletişime geçin.";
}
@await Html.PartialAsync("_MarketingCta")
