@{
    ViewData["Title"] = "Ürün";
    ViewData["Description"] = "TriPay Payment Hub özellikleri: çoklu sanal POS, 3D Secure, taksit, iade ve webhook.";
}
<section class="bg-ink-950 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl font-bold tracking-tight text-white">TriPay Payment Hub</h1>
        <p class="mt-4 max-w-2xl text-lg text-slate-300">Ödeme kanallarını tek .NET katmanında birleştiren, genişletilebilir ve test edilebilir altyapı.</p>
    </div>
</section>
<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-2">
        <div class="card">
            <h2 class="text-xl font-bold text-ink-950">Çoklu gateway</h2>
            <p class="mt-2 text-ink-600">Aynı sipariş akışında farklı banka ve kuruluşlar. Üye işyeri bazında hangi kanalın kullanılacağını tanımlarsınız.</p>
        </div>
        <div class="card">
            <h2 class="text-xl font-bold text-ink-950">3D Secure ve taksit</h2>
            <p class="mt-2 text-ink-600">Kartlı ödemede bankanın istediği doğrulama adımları ve BIN’e göre taksit seçenekleri standart akışta.</p>
        </div>
        <div class="card">
            <h2 class="text-xl font-bold text-ink-950">İade ve iptal</h2>
            <p class="mt-2 text-ink-600">Başarılı işlemler için iade talebi; operasyon ekibinin panelden izlemesi mümkün.</p>
        </div>
        <div class="card">
            <h2 class="text-xl font-bold text-ink-950">Güvenli geri dönüş</h2>
            <p class="mt-2 text-ink-600">Bankadan dönen sonuçlar doğrulanır; kart numarası veritabanına yazılmaz.</p>
        </div>
        <div class="card">
            <h2 class="text-xl font-bold text-ink-950">Önbellek ve kuyruk</h2>
            <p class="mt-2 text-ink-600">Yoğun trafikte gateway ayarları ve asenkron bildirimler için Redis ve mesaj kuyruğu desteği.</p>
        </div>
        <div class="card">
            <h2 class="text-xl font-bold text-ink-950">Yönetim paneli</h2>
            <p class="mt-2 text-ink-600">Hosted modda işlem, üye işyeri, gateway hataları ve raporlar için ayrı admin yüzü.</p>
        </div>
    </div>
</section>
