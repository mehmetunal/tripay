@{
    ViewData["Title"] = "Güvenlik";
}
<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="section-title">Güvenlik ve uyumluluk</h1>
    <p class="section-lead">Ödeme sistemlerinde güven, tasarımın parçasıdır — sonradan eklenmez.</p>
    <ul class="mt-12 grid gap-6 sm:grid-cols-2">
        <li class="card">
            <h2 class="font-bold text-ink-950">Kart verisi saklanmaz</h2>
            <p class="mt-2 text-sm text-ink-600">PAN ve CVV kalıcı depoda tutulmaz; loglarda maskeleme uygulanır.</p>
        </li>
        <li class="card">
            <h2 class="font-bold text-ink-950">İmzalı bildirimler</h2>
            <p class="mt-2 text-sm text-ink-600">Üye işyerine giden ödeme sonucu bildirimleri paylaşılan gizli anahtar ile doğrulanabilir.</p>
        </li>
        <li class="card">
            <h2 class="font-bold text-ink-950">HTTPS ve HSTS</h2>
            <p class="mt-2 text-sm text-ink-600">Canlı ortamda zorunlu TLS; yönlendirme ve güvenli çerez politikaları.</p>
        </li>
        <li class="card">
            <h2 class="font-bold text-ink-950">Admin erişim kontrolü</h2>
            <p class="mt-2 text-sm text-ink-600">Rol ve izin tabanlı panel; hassas uçlar için IP kısıtı yapılandırılabilir.</p>
        </li>
    </ul>
    <a href="@SiteLinks.DocsPath/Kilavuz/Security" class="mt-10 inline-flex btn-primary">Kılavuz: güvenlik bölümü</a>
</section>
