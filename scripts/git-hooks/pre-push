#!/usr/bin/env bash
# Push öncesi zorunlu test doğrulaması. Atlamak için: SKIP_TESTS=1 git push ...
set -euo pipefail

if [[ "${SKIP_TESTS:-}" == "1" ]]; then
  echo "TriPay: SKIP_TESTS=1 — testler atlandı (önerilmez)."
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
exec "$ROOT/scripts/verify-tests.sh"
