<Project>
  <!-- Meta paketler: PackageReference sürümü TriPay.NuGet.Version.props'tan gelir -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- Kütüphanelerle aynı: .NET 8, 9, 10 ve üzeri (yeni major SDK’lar eklenebilir) -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>
</Project>
