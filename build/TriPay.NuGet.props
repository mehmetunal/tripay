<Project>
  <!-- TriPay NuGet paketi — sürüm ve meta veri tek kaynak -->
  <PropertyGroup Label="TriPay NuGet Package">
    <IsPackable>true</IsPackable>
    <PackageId>TriPay</PackageId>
    <Version>1.0.0</Version>
    <Authors>TriPay</Authors>
    <Company>TriPay</Company>
    <Product>TriPay Payment Hub</Product>
    <Description>TriPay Payment Hub — sanal POS adaptörleri (Framework modu: kendi DB ve banka config'iniz; TriPay işlem saklamaz). Hosted mod için TriPay.Data ayrıca eklenir. .NET 8, 9, 10.</Description>
    <PackageTags>payment;fintech;virtual-pos;iyzico;vakifbank;tripay</PackageTags>
    <PackageProjectUrl>https://tripay.com.tr</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mehmetunal/tripay</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
