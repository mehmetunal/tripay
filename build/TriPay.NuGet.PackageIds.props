<Project>
  <!-- Kütüphane projeleri: PackageId ve README -->
  
  <!-- Standalone paket olarak yayınlanmayacak iç projeler -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'TriPay.Core' Or '$(MSBuildProjectName)' == 'TriPay.Data' Or '$(MSBuildProjectName)' == 'TriPay.Infrastructure' Or '$(MSBuildProjectName)' == 'TriPay.Persistence'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- ANA PAKET: TriPay (Framework Modu - Mod A) -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'TriPay.Services'">
    <PackageId>TriPay</PackageId>
    <Description>TriPay Framework Modu (Mod A) — Sanal POS entegrasyonu için ana kütüphane. Modeller, servisler ve Redis desteği içerir. TriPay MSSQL gerektirmez. .NET 8, 9, 10+.</Description>
    <PackageTags>tripay;payment;framework;virtual-pos;iyzico;vakifbank;vakifpays</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'TriPay.Services'">
    <None Include="$(MSBuildThisFileDirectory)..\docs\nuget\TriPay.md" Pack="true" PackagePath="\README.md" Link="README.md" />
  </ItemGroup>
</Project>
